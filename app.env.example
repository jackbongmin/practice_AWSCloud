# 11_01: 앱에 주는 환경 변수의 예시 — 서버에서 cp app.env.example app.env 로 복사해 쓴다. 비밀값은 여기(저장소)에 쓰지 않는다
SERVER_PORT=8080
SPRING_JPA_SHOW_SQL=false
# 11_02: 서버마다 다르게 (server-a, server-b) — /actuator/info에 보인다
APP_SERVER=server-a
# 11_03: RDS MySQL — <RDS 엔드포인트>와 비밀번호는 내 RDS 값으로 바꾼다
SPRING_PROFILES_ACTIVE=mysql
SPRING_DATASOURCE_URL=jdbc:mysql://<RDS 엔드포인트>:3306/review
SPRING_DATASOURCE_USERNAME=admin
SPRING_DATASOURCE_PASSWORD=<RDS 비밀번호>
# 로드밸런서 상태 검사용 /actuator/health/liveness 를 켠다 (DB가 느려도 바로 답한다)
MANAGEMENT_ENDPOINT_HEALTH_PROBES_ENABLED=true
